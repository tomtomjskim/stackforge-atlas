{
  "color": {
    "$type": "color",
    "brand": {
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2,
            0.31,
            0.88
          ],
          "alpha": 1
        },
        "$description": "Brand reference color"
      }
    },
    "action": {
      "primary": {
        "background": {
          "$value": "{color.brand.600}",
          "$description": "Primary action background"
        },
        "foreground": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 1
          }
        }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "control": {
      "inline": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "stack": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      }
    }
  },
  "duration": {
    "$type": "duration",
    "feedback": {
      "$value": {
        "value": 160,
        "unit": "ms"
      }
    }
  }
}
