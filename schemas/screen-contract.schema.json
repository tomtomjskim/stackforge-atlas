{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackforge-atlas.dev/schemas/screen-contract.schema.json",
  "title": "StackForge Atlas Screen Contract",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "route",
    "purpose",
    "actors",
    "entry_points",
    "layout",
    "fields",
    "actions",
    "states",
    "responsive",
    "accessibility",
    "telemetry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "actors": {
      "type": "array",
      "minItems": 1
    },
    "entry_points": {
      "type": "array",
      "minItems": 1
    },
    "layout": {
      "type": "object",
      "required": [
        "regions"
      ],
      "properties": {
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "priority",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "priority": {
                "type": "string"
              },
              "purpose": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        }
      }
    },
    "data_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation_id",
          "consumers",
          "required_for",
          "refresh"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_for": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "refresh": {
            "type": "object"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "required",
          "validation_owner",
          "data_source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "validation_owner": {
            "enum": [
              "frontend",
              "backend",
              "shared"
            ]
          },
          "data_source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intent",
          "kind",
          "operation_id",
          "permission",
          "destructive",
          "idempotency_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "intent": {
            "type": "string",
            "minLength": 5
          },
          "kind": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "permission": {
            "type": "string",
            "minLength": 1
          },
          "destructive": {
            "type": "boolean"
          },
          "idempotency_required": {
            "type": "boolean"
          }
        }
      }
    },
    "states": {
      "type": "object",
      "required": [
        "initial",
        "loading",
        "ready",
        "empty",
        "partial",
        "stale",
        "validation_error",
        "system_error",
        "forbidden",
        "conflict",
        "submitting",
        "success"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "behavior"
        ],
        "properties": {
          "behavior": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "responsive": {
      "type": "object",
      "required": [
        "narrow",
        "wide"
      ]
    },
    "accessibility": {
      "type": "object",
      "required": [
        "landmarks",
        "initial_focus",
        "error_focus",
        "announcements",
        "keyboard_notes"
      ]
    },
    "telemetry": {
      "type": "object",
      "required": [
        "outcome_events",
        "prohibited_data"
      ]
    }
  }
}
