{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackforge-atlas.dev/schemas/screen-contract.schema.json",
  "title": "StackForge Atlas Screen Contract",
  "type": "object",
  "required": ["id", "version", "name", "route", "purpose", "actors", "entry_points", "layout", "fields", "actions", "states", "responsive", "accessibility", "telemetry"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 2},
    "route": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 10},
    "actors": {"type": "array", "minItems": 1},
    "entry_points": {"type": "array", "minItems": 1},
    "layout": {
      "type": "object",
      "required": ["regions"],
      "properties": {"regions": {"type": "array", "minItems": 1}}
    },
    "fields": {"type": "array"},
    "actions": {"type": "array", "minItems": 1},
    "states": {
      "type": "object",
      "required": ["initial", "loading", "ready", "empty", "partial", "stale", "validation_error", "system_error", "forbidden", "conflict", "submitting", "success"],
      "additionalProperties": {
        "type": "object",
        "required": ["behavior"],
        "properties": {"behavior": {"type": "string", "minLength": 5}}
      }
    },
    "responsive": {
      "type": "object",
      "required": ["narrow", "wide"]
    },
    "accessibility": {
      "type": "object",
      "required": ["landmarks", "initial_focus", "error_focus", "announcements", "keyboard_notes"]
    },
    "telemetry": {
      "type": "object",
      "required": ["outcome_events", "prohibited_data"]
    }
  }
}
