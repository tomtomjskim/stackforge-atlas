{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackforge-atlas.dev/schemas/component-contract.schema.json",
  "title": "StackForge Atlas Component Contract",
  "type": "object",
  "required": ["id", "name", "status", "version", "purpose", "avoid_when", "anatomy", "variants", "states", "interaction", "content", "accessibility", "responsive", "tokens", "verification", "owners"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 2},
    "status": {"enum": ["proposed", "experimental", "stable", "deprecated", "retired"]},
    "version": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 10},
    "avoid_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "anatomy": {"type": "array", "minItems": 1},
    "variants": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "states": {"type": "object", "minProperties": 1},
    "interaction": {"type": "object", "required": ["keyboard", "focus", "async"]},
    "content": {"type": "object", "required": ["heading_max_characters", "message_max_characters", "reference_label_required", "localization_notes"]},
    "accessibility": {"type": "object", "required": ["semantics", "color_independence", "motion"]},
    "responsive": {"type": "object", "required": ["narrow", "wide"]},
    "tokens": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "owners": {"type": "object", "required": ["design", "engineering"]}
  }
}
