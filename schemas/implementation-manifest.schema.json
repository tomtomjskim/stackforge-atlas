{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackforge-atlas.dev/schemas/implementation-manifest.schema.json",
  "title": "StackForge Atlas Implementation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract",
    "screen_contract",
    "coverage",
    "runtime",
    "operations",
    "ui"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "contract": {
      "type": "string",
      "minLength": 1
    },
    "screen_contract": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "enum": [
        "exact",
        "partial"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version_line"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version_line": {
          "type": "string"
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "method",
          "path",
          "handler",
          "evidence"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS",
              "TRACE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "handler": {
            "type": "string",
            "minLength": 3
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "state_coverage",
        "implemented_states",
        "deferred_states",
        "evidence"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 3
        },
        "state_coverage": {
          "enum": [
            "exact",
            "accounted"
          ]
        },
        "implemented_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "deferred_states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "reason"
            ],
            "properties": {
              "state": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
