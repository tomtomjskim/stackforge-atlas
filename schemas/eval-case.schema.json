{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackforge-atlas.dev/schemas/eval-case.schema.json",
  "title": "StackForge Atlas Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "risk", "fixture", "task", "acceptance", "modes", "evidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "active", "retired"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_map", "implementation_manifest", "implementation_root", "source_contract"],
      "properties": {
        "project_map": { "type": "string" },
        "implementation_manifest": { "type": "string" },
        "implementation_root": { "type": "string" },
        "source_contract": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "goals", "non_goals"],
      "properties": {
        "prompt": { "type": "string", "minLength": 30 },
        "goals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "non_goals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "scenarios", "forbidden_changes"],
      "properties": {
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "expectation"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "expectation": { "type": "string", "minLength": 10 }
            }
          }
        },
        "forbidden_changes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["model-only", "minimal-harness", "skill-loaded", "full-workflow"] }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "notes"],
      "properties": {
        "result": { "enum": ["not-run", "passed", "failed", "partial"] },
        "notes": { "type": "string" }
      }
    }
  }
}
