{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackforge-atlas.dev/schemas/durability-manifest.schema.json",
  "title": "StackForge Atlas Durability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "data_store_profile",
    "migration",
    "transaction",
    "outbox",
    "audit",
    "recovery",
    "limitations"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "data_store_profile": { "type": "string", "minLength": 1 },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["up", "down", "runner", "version"],
      "properties": {
        "up": { "type": "string", "minLength": 1 },
        "down": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation", "entrypoint", "protected_resources", "atomic_writes"],
      "properties": {
        "isolation": { "enum": ["read-committed", "repeatable-read", "serializable"] },
        "entrypoint": { "type": "string", "minLength": 1 },
        "protected_resources": { "$ref": "#/$defs/nonEmptyStrings" },
        "atomic_writes": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "outbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "worker",
        "claim_strategy",
        "lease_seconds",
        "delivery_semantics",
        "provider_identity"
      ],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "worker": { "type": "string", "minLength": 1 },
        "claim_strategy": { "type": "string", "minLength": 1 },
        "lease_seconds": { "type": "integer", "minimum": 1 },
        "delivery_semantics": { "type": "string", "minLength": 5 },
        "provider_identity": { "type": "string", "minLength": 3 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "append_only", "enforcement"],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "append_only": { "type": "boolean" },
        "enforcement": { "type": "string", "minLength": 5 }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios"],
      "properties": {
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "expectation", "evidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "expectation": { "type": "string", "minLength": 10 },
              "evidence": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
